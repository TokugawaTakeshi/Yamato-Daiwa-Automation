block append Requirements

  include ../../../SharedAssets/Markup/SharedAssets.english.pug
  include ../../../SharedComponents/SharedComponents.english.pug

  -

    /** @type { RawObjectDataProcessor.PropertiesSpecification } */
    const $projectBuildingCommonSettingsSpecification =
        YDF.ValuesDeepCopier.deeplyCloneArbitraryValueAsPossible(
          $$YamatoDaiwaAutomationAPI.ProjectBuildingCommonSettings__FromFile__RawValid.propertiesSpecification
        );


block append Metadata

  -

    const {
      $heading: topHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.configurationFile.$children.commonSettings;

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        description:
          "The commot settings of the project build tool “Yamato Daiwa Automation” (abbreviated as “YDA”) either " +
              "not related with a specific task, or related to several tasks at once."
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("configurationFile.commonSettings");

    LanguageDropDownList__YDF_DK.setLinks({
      japanese: routing.japanese.configurationFile.$children.commonSettings.$URI,
      russian: routing.russian.configurationFile.$children.commonSettings.$URI
    });


